{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frienemies.studio/schemas/animation.pack.schema.json",
  "title": "Animation Pack",
  "type": "object",
  "required": ["id", "name", "version", "skeletonContract", "clips"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "skeletonContract": { "type": "string", "const": "v1" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri-reference" },
          "durationSec": { "type": "number", "minimum": 0 },
          "loop": { "type": "boolean" },
          "allowLocationTracks": {
            "description": "Optional extra BODY bones whose location tracks are intentionally allowed for this clip.",
            "type": "array",
            "items": { "type": "string" }
          },
          "tracks": {
            "description": "Optional extracted animation track/channel metadata used by validators before GLB playback/export.",
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "object",
                  "required": ["name"],
                  "properties": {
                    "name": { "type": "string" },
                    "target": { "type": "string" },
                    "bone": { "type": "string" },
                    "property": { "type": "string" },
                    "path": { "type": "string" },
                    "clipName": { "type": "string" },
                    "source": { "type": "string" }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "properties": {
        "allowLocationTracks": {
          "description": "Pack-level extra BODY bones whose location tracks are intentionally allowed.",
          "type": "array",
          "items": { "type": "string" }
        },
        "requireTrackMetadata": { "type": "boolean" }
      }
    },
    "rigAssumptions": {
      "type": "object",
      "properties": {
        "sourceRig": { "type": "string" },
        "sourceRestPose": { "type": "string", "enum": ["a-pose", "t-pose", "neutral", "unknown"] },
        "targetRestPose": { "type": "string", "enum": ["a-pose", "t-pose", "neutral", "unknown"] },
        "targetSkeletonContract": { "type": "string" },
        "unitScale": { "type": "number", "exclusiveMinimum": 0 },
        "bones": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
