{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frienemies.studio/schemas/animation.pack.schema.json",
  "title": "Animation Pack",
  "type": "object",
  "required": ["id", "name", "version", "skeletonContract", "clips"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "skeletonContract": { "type": "string", "const": "v1" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": { "type": "string" },
          "url": { "type": "string", "format": "uri" },
          "durationSec": { "type": "number", "minimum": 0 },
          "loop": { "type": "boolean" }
        }
      }
    }
  }
}
