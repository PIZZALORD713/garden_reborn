{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frienemies.studio/schemas/character.manifest.schema.json",
  "title": "Character Manifest",
  "type": "object",
  "required": ["version", "tokenId", "collection", "skeletonContract", "traits"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "tokenId": { "type": ["string", "integer"] },
    "owner": { "type": "string" },
    "collection": {
      "type": "object",
      "required": ["name", "contract", "chain"],
      "properties": {
        "name": { "type": "string" },
        "contract": { "type": "string" },
        "chain": { "type": "string" }
      }
    },
    "skeletonContract": { "type": "string", "const": "v1" },
    "traits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string" },
          "value": { "type": "string" },
          "asset_url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
